+        /* fuzzpos, colormap e a tabela em registradores: o store de byte nao deixa o compilador provar que nao aliasam */
+        const byte *cm6 = colormaps + 6*256;
+        const int *fz = fuzzoffset;
+        int fp = fuzzpos;
+        int n = count + 1;
+        do
+        {
