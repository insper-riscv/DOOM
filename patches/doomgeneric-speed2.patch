diff --git a/doomgeneric/i_video.c b/doomgeneric/i_video.c
index 84bebde..e0c219b 100644
--- a/doomgeneric/i_video.c
+++ b/doomgeneric/i_video.c
@@ -287,6 +287,13 @@ void I_InitGraphics (void)
 
 
     /* Allocate screen to draw to */
+#if defined(CMAP256) && !defined(DOOM_FPS_HUD)
+    /* Quadro indexado sem escala: o jogo desenha direto no DG_ScreenBuffer e o I_FinishUpdate nao copia */
+    if (fb_scaling == 1 && s_Fb.xres == SCREENWIDTH && s_Fb.yres == SCREENHEIGHT
+        && s_Fb.bits_per_pixel == 8)
+        I_VideoBuffer = (byte*)DG_ScreenBuffer;
+    else
+#endif
 	I_VideoBuffer = (byte*)Z_Malloc (SCREENWIDTH * SCREENHEIGHT, PU_STATIC, NULL);  // For DOOM to draw on
 
 	screenvisible = true;
@@ -297,6 +304,9 @@ void I_InitGraphics (void)
 
 void I_ShutdownGraphics (void)
 {
+#if defined(CMAP256) && !defined(DOOM_FPS_HUD)
+    if (I_VideoBuffer != (byte*)DG_ScreenBuffer)
+#endif
 	Z_Free (I_VideoBuffer);
 }
 
@@ -333,6 +343,13 @@ void I_FinishUpdate (void)
     //x_offset     = 0;
     x_offset_end = ((s_Fb.xres - (SCREENWIDTH  * fb_scaling)) * s_Fb.bits_per_pixel/8) - x_offset;
 
+#if defined(CMAP256) && !defined(DOOM_FPS_HUD)
+    if (I_VideoBuffer == (byte*)DG_ScreenBuffer)
+    {
+        DG_DrawFrame();
+        return;
+    }
+#endif
     /* DRAW SCREEN */
     line_in  = (unsigned char *) I_VideoBuffer;
     line_out = (unsigned char *) DG_ScreenBuffer;
